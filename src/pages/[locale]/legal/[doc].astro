---
import Base from "../../../layouts/Base.astro";
import PageTitle from "../../../components/PageTitle.astro";
import { marked } from "marked";
import msa from "@catenahq/contracts/legal/msa.json";
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";
import { locales, t } from "@catena/i18n";

export function getStaticPaths() {
  const docs = ["master-agreement", "sla", "subprocessors", "data-export-and-termination"];
  return locales.flatMap((locale) => docs.map((doc) => ({ params: { locale, doc } })));
}

const locale = Astro.params.locale as "en" | "fr";
const { doc } = Astro.params;
const altLocale = locale === "fr" ? "en" : "fr";

// The legal prose ships in @catenahq/contracts/legal/<doc>.md. Resolving it
// through the package exports, read at build time, means a contracts change
// that moves a file fails the build up front. The canonical legal text is
// English; every locale renders it with localized page chrome.
const req = createRequire(import.meta.url);
const rawMd = readFileSync(req.resolve(`@catenahq/contracts/legal/${doc}.md`), "utf8")
  // Cross-schedule links in the source are repo-relative .md paths;
  // rewrite them to the rendered routes for this locale.
  .replace(/\]\(([a-z-]+)\.md\)/g, `](/${locale}/legal/$1)`);
const html = marked.parse(rawMd) as string;

const key = `common.legal.${doc}`;
const pageTitle = t(locale, `${key}.title`);
---
<Base locale={locale} title={pageTitle} description={t(locale, `${key}.description`)}>
  <PageTitle title={pageTitle} intro={t(locale, `${key}.intro`)} />
  <section class="prose">
    <div class="container">
      <p class="version-pin">
        {doc === "master-agreement" ? (
          <Fragment>
            Version: <code>{msa.version.slice(0, 12)}</code>
            &middot; {`${t(locale, "common.legal.effective")} ${msa.effectiveDate}`}
          </Fragment>
        ) : (
          <a href={`/${locale}/legal/master-agreement`}>{t(locale, "common.legal.master-agreement.title")}</a>
        )}
        &middot; <a href={`/${altLocale}/legal/${doc}`} class="alt-locale">{t(locale, `common.lang.${altLocale}`)}</a>
      </p>
      <article set:html={html}></article>
    </div>
  </section>
</Base>

<style>
  .prose { padding: var(--catena-space-8) 0 var(--catena-space-24); }
  .prose article { max-width: 64rem; }
  .prose article h1 { font-size: var(--catena-fs-2xl); margin: 0 0 var(--catena-space-6); }
  .prose article h2 { font-size: var(--catena-fs-xl); margin: var(--catena-space-8) 0 var(--catena-space-3); }
  .prose article h3 { font-size: var(--catena-fs-lg); margin: var(--catena-space-6) 0 var(--catena-space-2); }
  .prose article p, .prose article li {
    line-height: var(--catena-lh-relaxed);
    margin: 0 0 var(--catena-space-3);
  }
  .prose article ul { padding-left: var(--catena-space-6); margin: 0 0 var(--catena-space-4); }
  .prose article table { border-collapse: collapse; margin: 0 0 var(--catena-space-4); }
  .prose article th, .prose article td {
    border: 1px solid var(--catena-border);
    padding: var(--catena-space-2) var(--catena-space-3);
    text-align: left;
  }
  .prose article blockquote {
    padding: var(--catena-space-4) var(--catena-space-5);
    border-left: 3px solid var(--catena-accent);
    background: var(--catena-surface-bg-muted);
    border-radius: var(--catena-radius-sm);
    margin: var(--catena-space-4) 0;
  }
  .prose article code { font-family: var(--catena-font-mono); font-size: 0.9em; }
  .version-pin {
    padding: var(--catena-space-4) var(--catena-space-5);
    border: 1px solid var(--catena-border);
    background: var(--catena-surface-bg-muted);
    border-radius: var(--catena-radius-sm);
    max-width: 64rem;
    margin-bottom: var(--catena-space-6);
    font-size: var(--catena-fs-sm);
  }
  .version-pin code { font-family: var(--catena-font-mono); }
  .alt-locale { text-decoration: underline; }
</style>
