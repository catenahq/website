---
import PolicyPage from "../../components/PolicyPage.astro";
import { locales, t } from "@catena/i18n";

export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }));
const locale = Astro.params.locale as "en" | "fr";
const sections = [
  "scope",
  "billing",
  "ownership",
  "liability",      // LEGAL REVIEW REQUIRED
  "sla",            // LEGAL REVIEW REQUIRED
  "aup",
  "termination",
  "perservice",
  "law",
];
---
<PolicyPage
  locale={locale}
  ns="terms"
  sections={sections}
  notice={t(locale, "common.terms.review_notice")}
/>
