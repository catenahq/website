---
import Base from "../../layouts/Base.astro";
import PageTitle from "../../components/PageTitle.astro";
import { locales, t } from "@catena/i18n";

export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }));
const locale = Astro.params.locale as "en" | "fr";
---
<Base
  locale={locale}
  title={t(locale, "common.status.title")}
  description={t(locale, "common.status.description")}
>
  <PageTitle
    title={t(locale, "common.status.title")}
    intro={t(locale, "common.status.intro")}
  />

  <section class="status-info">
    <div class="container">
      <h2>{t(locale, "common.status.what_title")}</h2>
      <p set:html={t(locale, "common.status.what_body_1")}></p>
      <p>{t(locale, "common.status.what_body_2")}</p>
      <p>{t(locale, "common.status.what_body_3")}</p>
      <h2>{t(locale, "common.status.dashboard_title")}</h2>
      <p class="muted" set:html={t(locale, "common.status.dashboard_body")}></p>
      <div class="placeholder">
        <p class="muted" set:html={t(locale, "common.status.placeholder")}></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .status-info {
    padding: var(--catena-space-16) 0;
  }
  .status-info h2 {
    margin-top: var(--catena-space-8);
    margin-bottom: var(--catena-space-3);
  }
  .status-info h2:first-child { margin-top: 0; }
  .status-info p {
    line-height: var(--catena-lh-relaxed);
    margin-bottom: var(--catena-space-4);
    max-width: 56rem;
  }
  .placeholder {
    margin-top: var(--catena-space-6);
    padding: var(--catena-space-6);
    border: 1px dashed var(--catena-surface-border);
    border-radius: var(--catena-radius-lg);
    background: var(--catena-surface-bg-muted);
  }
  .placeholder p { margin: 0; }
  /* The code element arrives through set:html, outside the scoped markup. */
  .status-info :global(code) {
    font-family: var(--catena-ff-mono);
    font-size: var(--catena-fs-sm);
    padding: 0 var(--catena-space-1);
    background: var(--catena-surface-bg-muted);
    border-radius: var(--catena-radius-sm);
  }
</style>
