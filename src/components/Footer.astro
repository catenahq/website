---
import { t } from "@catena/i18n";

interface Props {
  locale: "en" | "fr";
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
const prefix = `/${locale}`;
const docsHref = locale === "fr" ? "https://docs.catena.run/fr/" : "https://docs.catena.run/en/";

const productLinks = [
  { href: `${prefix}/faq`,          label: t(locale, "common.faq.title") },
  { href: docsHref,                 label: t(locale, "common.nav.docs") },
];

const companyLinks = [
  { href: `${prefix}/contact`,      label: t(locale, "common.nav.contact") },
  { href: `${prefix}/status`,       label: t(locale, "common.nav.status") },
  { href: "https://app.catena.run", label: t(locale, "common.nav.portal") },
  { href: "https://ma-lalonde.dev", label: t(locale, "common.footer.portfolio") },
];

const legalLinks = [
  { href: `${prefix}/privacy`,     label: t(locale, "common.privacy.title") },
  { href: `${prefix}/terms`,       label: t(locale, "common.terms.title") },
];
---
<footer class="site-footer">
  <div class="container">
    <nav class="footer-cols" aria-label="Footer">
      <div class="col">
        <h3>{t(locale, "common.footer.col_product")}</h3>
        <ul>
          {productLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="col">
        <h3>{t(locale, "common.footer.col_company")}</h3>
        <ul>
          {companyLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="col">
        <h3>{t(locale, "common.footer.col_legal")}</h3>
        <ul>
          {legalLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    </nav>
    <p class="muted copyright">
      &copy; {year} <span class="brand-mark">{t(locale, "common.brand.name")}</span>.
      {t(locale, "common.footer.rights")}
      {t(locale, "common.footer.made_in")}
      <a class="github-link" href="https://github.com/catenahq" aria-label={t(locale, "common.footer.github")}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
      </a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--catena-space-24);
    padding: var(--catena-space-12) 0 var(--catena-space-8);
    border-top: 1px solid var(--catena-surface-border);
    background: var(--catena-surface-bg-muted);
  }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--catena-space-8);
    margin-bottom: var(--catena-space-8);
  }
  .col h3 {
    font-size: var(--catena-fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--catena-tracking-wide);
    margin: 0 0 var(--catena-space-3) 0;
    color: var(--catena-surface-fg-muted);
  }
  .col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--catena-space-2);
  }
  .col a {
    font-size: var(--catena-fs-sm);
    color: var(--catena-surface-fg);
  }
  .col a:hover {
    text-decoration: underline;
  }
  .copyright {
    margin: 0;
    padding-top: var(--catena-space-6);
    border-top: 1px solid var(--catena-surface-border);
    font-size: var(--catena-fs-sm);
  }
  .brand-mark {
    font-family: "Conthrax", var(--catena-font-sans);
    font-weight: 600;
    text-transform: lowercase;
  }
  .github-link {
    display: inline-flex;
    align-items: center;
    margin-left: var(--catena-space-2);
    color: var(--catena-surface-fg-muted);
    vertical-align: middle;
  }
  .github-link:hover {
    color: var(--catena-surface-fg);
    text-decoration: none;
  }
  .github-link svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  @media (max-width: 767px) {
    .footer-cols {
      grid-template-columns: 1fr;
      gap: var(--catena-space-6);
    }
  }
</style>
