---
// A policy page (privacy, terms). Every string comes from the common.<ns>
// i18n namespace: title, description, intro, and one <section>_title /
// <section>_body pair per section. Bodies render as HTML.
import Base from "../layouts/Base.astro";
import PageTitle from "./PageTitle.astro";
import { t } from "@catena/i18n";

interface Props {
  locale: "en" | "fr";
  ns: string;
  sections: string[];
  notice?: string;
}

const { locale, ns, sections, notice } = Astro.props;
---
<Base
  locale={locale}
  title={t(locale, `common.${ns}.title`)}
  description={t(locale, `common.${ns}.description`)}
>
  <PageTitle
    title={t(locale, `common.${ns}.title`)}
    intro={t(locale, `common.${ns}.intro`)}
  />
  <section class="prose">
    <div class="container">
      {notice && <p class="review-notice">{notice}</p>}
      {sections.map((s) => (
        <article>
          <h2>{t(locale, `common.${ns}.${s}_title`)}</h2>
          <p set:html={t(locale, `common.${ns}.${s}_body`)}></p>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .prose { padding: var(--catena-space-8) 0 var(--catena-space-24); }
  .prose article { max-width: 64rem; margin-bottom: var(--catena-space-8); }
  .prose h2 {
    font-size: var(--catena-fs-xl);
    margin: 0 0 var(--catena-space-3) 0;
  }
  .prose p {
    margin: 0;
    line-height: var(--catena-lh-relaxed);
  }
  .review-notice {
    padding: var(--catena-space-4) var(--catena-space-5);
    border-left: 3px solid var(--catena-accent);
    background: var(--catena-surface-bg-muted);
    border-radius: var(--catena-radius-sm);
    max-width: 64rem;
    margin-bottom: var(--catena-space-8);
    font-size: var(--catena-fs-sm);
  }
</style>
