---
// Long-form text (policies, legal schedules) in the typography plugin's prose
// styles, following the page's light or dark scheme. Below the md breakpoint a
// table wider than the column scrolls inside it.
---
<section class="px-4 sm:px-6 lg:px-8 pb-16 lg:pb-20 mx-auto max-w-4xl">
  <div class="prose prose-lg max-w-none dark:prose-invert prose-headings:font-heading prose-headings:tracking-tight prose-a:text-link max-md:prose-table:block max-md:prose-table:overflow-x-auto">
    <slot />
  </div>
</section>
