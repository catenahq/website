---
interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---
<section class="px-4 sm:px-6 lg:px-8 pt-16 pb-8 lg:pt-20 mx-auto max-w-4xl text-center">
  <h1 class="font-bold font-heading text-heading text-4xl md:text-5xl leading-tight tracking-tight">{title}</h1>
  {intro && <p class="mt-4 text-xl text-muted text-pretty">{intro}</p>}
</section>
