---
// Home "apps" section: where to find apps to host on Catena (public
// directories, the pre-integrated template catalog, and the docs page on
// deploying an app).
import { t } from "@catena/i18n";

interface Props {
  locale: "en" | "fr";
}
const { locale } = Astro.props;
---
<section id="apps" class="apps">
  <div class="container">
    <h2>{t(locale, "common.home.apps.title")}</h2>
    <p class="lead">{t(locale, "common.home.apps.intro")}</p>
    <p class="muted" set:html={t(locale, "common.home.apps.discover")}></p>
    <p class="muted" set:html={t(locale, "common.home.apps.catalog")}></p>
  </div>
</section>

<style>
  .apps {
    padding: var(--catena-space-24) 0;
  }
  .apps p {
    max-width: 56rem;
    line-height: var(--catena-lh-relaxed);
  }
  .lead {
    font-size: var(--catena-fs-lg);
  }
</style>
