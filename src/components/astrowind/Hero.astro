---
import Actions from "./Actions.astro";
import type { CallToAction } from "./types";

interface Props {
  title: string;
  subtitle?: string;
  actions?: CallToAction[];
  id?: string;
}

const { title, subtitle, actions = [], id } = Astro.props;

const reveal = "intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade";
---

<section class="relative md:-mt-[76px] not-prose" {...(id ? { id } : {})}>
  <div class="absolute inset-0 pointer-events-none hero-bg" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
    <div class="py-16 md:py-28">
      <div class="text-center max-w-5xl mx-auto">
        <h1 class:list={["text-5xl md:text-6xl font-bold leading-tight tracking-tight mb-6 font-heading text-heading", reveal]} set:html={title} />
        <div class="max-w-3xl mx-auto">
          {subtitle && <p class:list={["text-xl text-muted mb-8", reveal]} set:html={subtitle} />}
          {actions.length > 0 && <Actions actions={actions} class={reveal} />}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-bg {
    background:
      radial-gradient(circle at 20% 0%, color-mix(in srgb, var(--catena-accent) 18%, transparent) 0%, transparent 45%),
      radial-gradient(circle at 80% 30%, color-mix(in srgb, var(--catena-primary-300) 15%, transparent) 0%, transparent 50%);
  }
</style>
