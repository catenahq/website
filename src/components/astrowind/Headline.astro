---
import { twMerge } from "tailwind-merge";
import type { Headline as Props } from "./types";

const { title, subtitle, tagline, classes = {} } = Astro.props;

const {
  container: containerClass = "max-w-3xl",
  title: titleClass = "text-3xl md:text-4xl",
  subtitle: subtitleClass = "text-xl",
} = classes;
---

{
  (title || subtitle || tagline) && (
    <div class={twMerge("mb-8 md:mx-auto md:mb-12 text-center", containerClass)}>
      {tagline && <p class="text-base text-secondary dark:text-accent font-bold tracking-wide uppercase" set:html={tagline} />}
      {title && (
        <h2
          class={twMerge("font-bold leading-tight tracking-tight font-heading text-heading text-balance", titleClass)}
          set:html={title}
        />
      )}
      {subtitle && <p class={twMerge("mt-4 text-muted text-pretty", subtitleClass)} set:html={subtitle} />}
    </div>
  )
}
