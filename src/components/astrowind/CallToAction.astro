---
import Actions from "./Actions.astro";
import Headline from "./Headline.astro";
import WidgetWrapper from "./WidgetWrapper.astro";
import type { CallToAction } from "./types";

interface Props {
  title: string;
  subtitle?: string;
  actions: CallToAction[];
  id?: string;
}

const { title, subtitle, actions, id } = Astro.props;
---

<WidgetWrapper id={id} containerClass="max-w-6xl">
  <div class="text-center max-w-3xl mx-auto p-6 md:p-12 rounded-lg shadow-xl border border-line bg-page">
    <Headline
      title={title}
      subtitle={subtitle}
      classes={{
        container: "mb-0 md:mb-0",
        title: "text-4xl md:text-4xl font-bold tracking-tight mb-4 font-heading",
        subtitle: "text-xl text-muted",
      }}
    />
    <Actions actions={actions} class="mt-6" />
  </div>
</WidgetWrapper>
