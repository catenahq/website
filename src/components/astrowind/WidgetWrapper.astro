---
import { twMerge } from "tailwind-merge";

interface Props {
  id?: string;
  containerClass?: string;
  /** A muted band behind the section, to set it apart from its neighbours. */
  muted?: boolean;
}

const { id, containerClass = "", muted = false } = Astro.props;
---

<section class:list={["relative not-prose scroll-mt-[72px]", { "bg-page-muted": muted }]} {...(id ? { id } : {})}>
  <div
    class={twMerge(
      "relative mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-20 text-default intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade",
      containerClass
    )}
  >
    <slot />
  </div>
</section>
