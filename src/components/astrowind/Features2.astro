---
import { Icon } from "astro-icon/components";
import Headline from "./Headline.astro";
import WidgetWrapper from "./WidgetWrapper.astro";
import { getColumnsClass, type Item } from "./types";

interface Props {
  title?: string;
  subtitle?: string;
  items: Item[];
  columns?: number;
  id?: string;
  muted?: boolean;
}

const { title, subtitle, items, columns = 3, id, muted = false } = Astro.props;
---

<WidgetWrapper id={id} muted={muted}>
  <Headline title={title} subtitle={subtitle} />
  <div class:list={["grid gap-4 md:gap-6 gap-x-12", getColumnsClass(columns)]}>
    {
      items.map(({ title: itemTitle, description, icon }) => (
        <div class="relative flex flex-col rounded-lg shadow-[0_4px_30px_rgba(0,0,0,0.1)] border border-line bg-page p-6 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          {icon && <Icon name={icon} class="mb-6 w-12 h-12 text-primary dark:text-accent" />}
          <h3 class="text-xl font-bold text-heading">{itemTitle}</h3>
          {description && <p class="text-muted mt-2" set:html={description} />}
        </div>
      ))
    }
  </div>
</WidgetWrapper>
