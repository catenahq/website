---
import Base from "../layouts/Base.astro";
import PageTitle from "./PageTitle.astro";
import Button from "./astrowind/Button.astro";
import { t } from "@catena/i18n";
import { docsHref } from "../navigation";

interface Props {
  locale: "en" | "fr";
}

const { locale } = Astro.props;
const title = t(locale, "common.notfound.title");
const headline = t(locale, "common.notfound.headline");
const links = [
  { href: `/${locale}/`, text: t(locale, "common.notfound.links.home") },
  { href: docsHref(locale), text: t(locale, "common.notfound.links.docs") },
  { href: `/${locale}/contact`, text: t(locale, "common.notfound.links.contact") },
];
---
<Base locale={locale} title={title} description={headline}>
  <PageTitle title={title} intro={headline} />
  <section class="px-4 pb-20 mx-auto max-w-3xl text-center">
    <p class="text-muted mb-8">{t(locale, "common.notfound.body")}</p>
    <ul class="flex flex-wrap justify-center gap-3">
      {links.map((l) => (
        <li><Button href={l.href} text={l.text} /></li>
      ))}
    </ul>
  </section>
</Base>
