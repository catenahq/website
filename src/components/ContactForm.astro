---
import { t } from "@catena/i18n";
import Button from "./astrowind/Button.astro";
import Headline from "./astrowind/Headline.astro";
import WidgetWrapper from "./astrowind/WidgetWrapper.astro";

interface Props {
  locale: "en" | "fr";
}

const { locale } = Astro.props;

const intents = ["managed", "community", "website", "partnership", "other"];
const k = (key: string) => t(locale, `common.contact.form.${key}`);
const field = "py-3 px-4 block w-full rounded-lg border border-line bg-page text-default font-normal";
---
<WidgetWrapper muted>
  <Headline title={k("title")} subtitle={k("intro")} />
  <div class="flex flex-col max-w-xl mx-auto rounded-lg border border-line bg-page shadow p-4 sm:p-6 lg:p-8 w-full">
    <!--
      TODO before launch: wire to a Cloudflare Worker or Formspree
      endpoint and replace the action URL below. The Worker should
      forward to hello@catena.run + post to a healthchecks-style
      monitor so missed submissions get noticed.
    -->
    <form action="https://formspree.io/f/REPLACE" method="POST" class="grid gap-6">
      <label class="flex flex-col gap-2 text-sm font-medium">
        {k("name_label")}
        <input type="text" name="name" required autocomplete="name" class={field} />
      </label>
      <label class="flex flex-col gap-2 text-sm font-medium">
        {k("email_label")}
        <input type="email" name="email" required autocomplete="email" class={field} />
      </label>
      <label class="flex flex-col gap-2 text-sm font-medium">
        {k("company_label")}
        <input type="text" name="company" autocomplete="organization" class={field} />
      </label>
      <fieldset class="flex flex-col gap-2 rounded-lg border border-line p-4">
        <legend class="px-2 text-sm font-medium">{k("intent_label")}</legend>
        {intents.map((intent) => (
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" name="intent" value={intent} class="accent-primary" />
            {k(`intent_${intent}`)}
          </label>
        ))}
      </fieldset>
      <label class="flex flex-col gap-2 text-sm font-medium">
        {k("message_label")}
        <textarea name="message" required rows="6" class:list={[field, "resize-y"]}></textarea>
      </label>
      <Button variant="primary" type="submit">{k("submit_label")}</Button>
    </form>
    <p class="mt-6 text-center text-sm text-muted">{t(locale, "common.contact.response_body")}</p>
    <p class="mt-3 text-center text-sm text-muted">
      {k("mailto_fallback")}
      <a class="text-link underline" href="mailto:hello@catena.run">hello@catena.run</a>
    </p>
  </div>
</WidgetWrapper>
